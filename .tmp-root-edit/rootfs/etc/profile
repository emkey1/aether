#
#  Script that is part of deploy,  wrap it inside other script
#  so that any error exits dont exit ish, just aborts deploy
#  special case exit 123 exits the profile, useful for prebuild
#  to exit out of the chroot
#
/opt/AOK/choose_distro/select_distro.sh
ex_code="$?"
[ "$ex_code" = "123" ] && exit  # 123=prebuild done, exit without error
if [ "$ex_code" -ne 0 ]; then
    echo "ERROR: /opt/AOK/choose_distro/select_distro.sh exited with code: $ex_code"
fi

#
#  Since the deploy script was run in a subshell, its path
#  cant be shared when exiting deploy and dropping into an
#  interactive env, so here comes a generic path
#
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
