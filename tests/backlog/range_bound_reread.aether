// Backlog probe (W4-33): the range bound is re-read every pass.
// Correct behaviour: prints 10.
// When this is fixed (the bound evaluated once, ahead of the loop), move the
// bound's hoists ahead of the loop too: parseLoopRange in src/aether/ast_lower.c
// takes them with aetherTakePendingHoists and runs them before every test, so a
// slice in the bound follows today's re-read (CHANGELOG 2026-10-15-1).
fn main() -> Void {
    let n: Int = 10;
    let runs: Int = 0;
    loop i in 0..n {
        n = n - 1;
        runs = runs + 1;
    }
    fx { println(runs); }
}
