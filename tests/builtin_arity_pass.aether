// Regression: every arity the BUILT-002 table accepts must still compile --
// including formatfloat's optional-precision one-argument form, which the
// published signature (value: Real, precision: Int) does not advertise, so a
// signature-derived arity check would have wrongly rejected it.
fn main() -> Void {
    let r: Real = 87.4567;
    let hello: Text = "hello";
    fx {
        println(formatfloat(r, 2), " ", formatfloat(r), " ", realtostr(r));
        println(clamp(5, 1, 3), " ", min(2, 9), " ", max(2, 9));
        println(ord("A"), " ", chr(66), " ", hello[1..4]);
        println(index_of("hello", "ll"), " ", trim("  x  "));
        println(parse_int("7"), " ", parse_bool("true"), " ", length(split("a,b", ",")));
    }
    ret;
}
