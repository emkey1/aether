// guides: full medium
// recipes: evensDoubled lookup
//
// Driver for the guides' loop recipes (filter/map and the lookup table) and,
// since D56/D57 (2026-10-17), for the builtins that replaced the hand-rolled
// sum/sort/join/upper/contains/starts-with/replace recipes: the same inputs
// must give what those recipes gave (replace now changes every occurrence).
// The gate (tools/verify_guide_snippets.py --run) extracts each recipe named
// above from each guide named above, puts this main after them, and compares
// stdout with writing_surface.out.
fn main() -> Void {
    let xs: Int[] = [5, 3, 9, 3, 1];
    let neg: Int[] = [-2, 7, -9, 0];
    let e: Int[] = [];
    let one: Int[] = [7];
    let s: Int[] = sorted(xs);
    let sn: Int[] = sorted(neg);
    let none: Text[] = [];
    let (d1, ok1) = try_parse_int("0123");
    let (d2, ok2) = try_parse_int("12a");
    let (d3, ok3) = try_parse_int("");
    let (d4, ok4) = try_parse_int("-1");
    fx {
        println("total ", sum(xs), " ", sum(e), " ", sum(neg));
        println("mean ", sum(xs) * 1.0 / length(xs):0:2, " ", sum(one) * 1.0 / length(one):0:2);
        println("largest ", max_of(xs), " ", max_of(neg), " ", max_of(one));
        println("sorted ", s[0], s[1], s[2], s[3], s[4], " len ", length(s));
        println("sorted-neg ", sn[0], " ", sn[1], " ", sn[2], " ", sn[3]);
        println("input-untouched ", xs[0], xs[4]);
        println("sorted-edge ", length(sorted(e)), " ", sorted(one)[0]);
        println("join [", join(["a", "b", "c"], ", "), "] [", join(none, "-"), "] [",
                join(["solo"], "+"), "]");
        println("upper ", upper("Hello, World! az{`"), " [", upper(""), "]");
        println("contains ", contains("haystack", "st"), " ", contains("haystack", "zz"), " ",
                contains("haystack", "hay"), " ", contains("haystack", "ack"));
        println("startsWith ", starts_with("prefix", "pre"), " ", starts_with("pr", "prefix"), " ",
                starts_with("prefix", "fix"), " ", starts_with("same", "same"));
        println("replace ", replace("a-b-c", "-", "+"), " ", replace("abc", "x", "y"),
                " ", replace("abc", "c", "Z"), " ", replace("abc", "a", ""),
                " ", replace("aaa", "aa", "b"));
        let ev: Int[] = evensDoubled([1, 2, 3, 4, -6]);
        println("evensDoubled ", length(ev), " ", ev[0], " ", ev[1], " ", ev[2], " ",
                length(evensDoubled([1, 3])));
        println("try_parse_int ", ok1, d1, " ", ok2, d2, " ", ok3, d3, " ", ok4, d4);
        println("lookup ", lookup(["x", "y"], [10, 20], "y"), " ", lookup(["x", "y"], [10, 20], "q"),
                " ", lookup([], [], "x"), " ", lookup(["k", "k"], [1, 2], "k"));
    }
    ret;
}
