// Same-process TCP client+server pair over the real socket* API, coordinated
// with par so accept()/receive() never block indefinitely: the listening
// socket is created, bound, and put into listen state before the par block
// starts, so the client branch can never race ahead of a not-yet-listening
// server.
type Message {
    payload: Text;
}

fn server(listenSock: Int, out: Message) -> Void {
    fx {
        let conn: Int = socketaccept(listenSock);
        let ms: MStream = socketreceive(conn, 256);
        out.payload = mstreambuffer(ms);
        println("server got: ", out.payload);
        socketsend(conn, "pong");
        mstreamfree(ms);
        socketclose(conn);
        socketclose(listenSock);
    }
    ret;
}

fn client(port: Int, out: Message) -> Void {
    fx {
        let sock: Int = socketcreate(0);
        socketconnect(sock, "127.0.0.1", port);
        socketsend(sock, "ping");
        let ms: MStream = socketreceive(sock, 256);
        out.payload = mstreambuffer(ms);
        println("client got: ", out.payload);
        mstreamfree(ms);
        socketclose(sock);
    }
    ret;
}

// The listener takes the first free port from 23557 up rather than 23557
// itself: two suites running at once on one machine (two agents, or a local
// run beside CI) used to meet on the same port, and one of them hung or failed.
// socketbind returns 0 on success and -1 when the port is taken.
fn main() -> Void {
    let port: Int = 23557;
    let lastPort: Int = 23757;
    let bound: Bool = false;
    let listenSock: Int = 0;
    let serverMsg: Message = new Message();
    let clientMsg: Message = new Message();
    fx {
        listenSock = socketcreate(0);
        loop !bound && port < lastPort {
            if socketbind(listenSock, port) == 0 {
                bound = true;
            } else {
                port = port + 1;
            }
        }
        if bound {
            socketlisten(listenSock, 1);
        }
    }
    if !bound {
        fx { println("no free port in 23557..23756"); }
        ret;
    }
    par {
        server(listenSock, serverMsg);
        client(port, clientMsg);
    }
    fx { println("done"); }
    ret;
}
