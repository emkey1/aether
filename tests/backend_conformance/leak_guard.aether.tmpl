// Template: the runner substitutes @N@ and runs it at two sizes, then
// compares peak RSS. Every indexed read or write allocates one ArrayObj that
// is never freed (pscal-core 62d4139, B-performance-1), about 80 bytes per
// access; the runner fails above 8 bytes per access. Fixed by W5-03.
fn main() -> Void {
    let xs: Int[] = [1, 2, 3, 4, 5, 6, 7, 8];
    let ys: Int[] = [0, 0, 0, 0, 0, 0, 0, 0];
    let total: Int = 0;
    let i: Int = 0;
    loop i < @N@ {
        total = total + xs[i % 8];
        ys[i % 8] = total;
        i = i + 1;
    }
    fx {
        if total == (@N@ / 8) * 36 && ys[7] == total {
            println("ok");
        } else {
            println("bad total ", total);
        }
    }
    ret;
}
