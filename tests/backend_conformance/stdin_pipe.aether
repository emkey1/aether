// A line of piped stdin into a piped stdout (B-backend-coupling-4). A stdin
// readln once stripped the line's leading whitespace and split a line longer
// than 1023 bytes (fixed by W5-12); readln's replacement read_line (D60) keeps
// both. The expected stdout is byte-exact.
fn main() -> Void {
    let a: Text = "";
    let b: Text = "";
    let c: Text = "";
    fx {
        a = read_line();
        b = read_line();
        c = read_line();
        println("[", a, "]");
        println("[", b, "]");
        println(length(c));
    }
    ret;
}
