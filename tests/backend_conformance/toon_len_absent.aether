// toon_len of an absent key (A-probe-full-B-2). It gave -1 while a null node
// gave 0, so `loop i < toon_len(n)` was safe only by accident. Fixed by W5-09
// (pscal-core e48ce37): an absent node is 0, like null.
fn main() -> Void {
    let doc: ToonDoc = toon_parse("{\"jobs\":[1,2,3]}");
    let root: ToonNode = toon_root(doc);
    let jobs: ToonNode = toon_key(root, "jobs");
    let missing: ToonNode = toon_key(root, "nope");
    fx {
        println(toon_len(jobs));
        println(toon_len(missing));
        println(toon_len(toon_null()));
    }
    toon_close(doc);
    ret;
}
