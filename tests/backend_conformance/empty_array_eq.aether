// `==` on empty arrays (A-guide-accuracy-small-10). An empty array that went
// through the engine's setlength (a call's un-alias copy, a parameter copy, a
// slice; before D55 also an explicit setlength) compares unequal to one that
// did not. Fixed by W5-08.
fn evens(xs: Int[]) -> Int[] {
    let out: Int[] = [];
    loop i in 0..length(xs) {
        if xs[i] % 2 == 0 {
            out = out + [xs[i]];
        }
    }
    ret out;
}

fn main() -> Void {
    let r: Int[] = evens([1, 3, 5]);
    let e: Int[] = [];
    let xs: Int[] = [4, 5];
    xs = xs[..0];
    fx {
        println(evens([1, 3, 5]) == []);
        println(r == []);
        println(r == e);
        println(xs == e);
        println(length(r));
    }
    ret;
}
