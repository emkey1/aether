// A line of piped stdin into a piped stdout (B-backend-coupling-4). Each
// stdin readln used to write ESC[?25h (show cursor) to stdout even when it was
// not a terminal, so piped output began with an escape sequence (fixed by
// W5-12a). read_line (D60) shares readln's reader. The expected stdout is
// byte-exact.
fn main() -> Void {
    let a: Text = "";
    fx {
        a = read_line();
        println("got[", a, "]");
    }
    ret;
}
