// Literal-derived Int arithmetic past 2^31 (B-runtime-semantics-2,
// B-type-system-1). Aether `Int` is 64-bit, but a literal that fits in 32 bits
// is an INT32 value at runtime, and INT32 op INT32 is narrowed back to 32 bits:
// every line below prints a wrapped value with exit 0 on pscal-core 607a4e8.
// Fixed by W5-04 (widen on INT32 overflow, Int builtins, folding).
fn fact(n: Int) -> Int {
    if n <= 1 {
        ret 1;
    }
    ret n * fact(n - 1);
}

fn mulmod(a: Int, b: Int, m: Int) -> Int {
    ret (a * b) % m;
}

fn main() -> Void {
    let s: Int = 100 * 365 * 24 * 60 * 60;
    fx {
        println(fact(20));
        println(100000 * 100000);
        println(s);
        println(pow(2, 31));
        println(parse_int("3000000000"));
        println(1 << 40);
        println(-2147483647 - 10);
        println(mulmod(123456789, 987654321, 1000000007));
    }
    ret;
}
