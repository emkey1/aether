// Int paths that are still 32-bit after core-0 (B-runtime-semantics-2,
// B-type-system-1): parse_int of a value past 2^31 wraps, and `<<` shifts in
// 32 bits, each with exit 0. Literal-derived arithmetic is fixed and covered by
// int64_literal. Fixed by W5-04 steps 3 and 5 (shift, Int builtins).
fn main() -> Void {
    fx {
        println(parse_int("3000000000"));
        println(1 << 40);
    }
    ret;
}
