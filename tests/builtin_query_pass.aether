fn main() -> Void {
    let names: Text = builtins_json();
    let detailed: Text = builtins_json(true);
    let sleepInfo: Text = builtin_info("sleep");
    let toonInfo: Text = builtin_info("toon_len");

    fx {
        println(index_of(names, "sleep") >= 0);
        println(index_of(detailed, "builtins_json") >= 0);
        println(index_of(sleepInfo, "\"backend_name\":\"delay\"") >= 0);
        println(index_of(toonInfo, "toon_len") >= 0);
    }
    ret;
}
