// Regression: the one-call file helpers (D60, 2026-10-17) that replaced the
// Pascal File sequence (assign/rewrite/writeln/reset/readln/eof/close/erase).
// write_file creates or truncates, append_file adds, read_lines splits on line
// breaks without keeping them, read_file returns the bytes as Text, and
// delete_file / rename_file / file_exists report what happened.
fn main() -> Void {
    fx {
        write_file("aether_file_io_pass_tmp.txt", "alpha\n");
        append_file("aether_file_io_pass_tmp.txt", "beta\n");
        let lines: Text[] = read_lines("aether_file_io_pass_tmp.txt");
        loop i in 0..length(lines) {
            println("read ", i + 1, ": ", lines[i]);
        }
        let all: Text = read_file("aether_file_io_pass_tmp.txt");
        println("bytes=", length(all));
        println("renamed=", rename_file("aether_file_io_pass_tmp.txt", "aether_file_io_pass_tmp2.txt"));
        println("deleted=", delete_file("aether_file_io_pass_tmp2.txt"));
        println("exists_after_erase=", file_exists("aether_file_io_pass_tmp2.txt"));
        println("delete_again=", delete_file("aether_file_io_pass_tmp2.txt"));
    }
    ret;
}
