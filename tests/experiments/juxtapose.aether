// D39 experiment fixture: an operator deleted between two operands. Today
// `price qty` parses as `price` followed by a discarded `qty`; tail=reject
// makes it SYN-001.
fn main() -> Void {
    let price: Int = 3;
    let qty: Int = 4;
    let total: Int = price qty;
    fx {
        println("total=", total);
    }
}
