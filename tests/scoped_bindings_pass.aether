// Function-scoped binding tables: same-name locals in different functions each
// keep their own type, and a function's locals leave a global const's type
// intact for later functions. Under the old program-flat tables this program
// failed twice: `let b = label;` inferred Int from a leaked local (a
// compile-time "Cannot assign STRING to integer"), and sum_real's
// `v = v + 1.0` drew a false [TYPE-001] because sum_int's `v: Int` clobbered
// the Real entry. A local that shadows the const itself is NAME-001 since
// W4-22 (D17): tests/fx/diag/const_shadow_fail.
const label: Text = "answer";

fn shadow_and_bump() -> Int {
    let bumped: Int = 40;
    ret bumped + 2;
}

fn sum_real() -> Void {
    let v: Real = 1.5;
    v = v + 1.0;
    fx { println(v); }
    ret;
}

fn sum_int() -> Void {
    let v: Int = 2;
    v = v + 1;
    fx { println(v); }
    ret;
}

fn text_side() -> Void {
    let tag: Text = "scoped";
    let echo = tag;
    fx { println(echo); }
    ret;
}

fn int_side() -> Void {
    let tag: Int = 41;
    let echo = tag;
    fx { println(echo + 1); }
    ret;
}

fn main() -> Void {
    let a = shadow_and_bump();
    let b = label; // infers Text from the restored global binding
    fx {
        println(a);
        println(b);
    }
    sum_real();
    sum_int();
    text_side();
    int_side();
    ret;
}
