fn main() -> Void {
    let arr: Int[] = [1, 3, 5, 7, 9, 11];
    let target: Int = 7;
    let low: Int = 0;
    let high: Int = length(arr) - 1;
    let result: Int = -1;

    loop low <= high {
        let mid: Int = (low + high) / 2;
        if arr[mid] == target {
            result = mid;
            break;
        }
        if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    fx {
        println("index = ", result);
    }
    ret;
}