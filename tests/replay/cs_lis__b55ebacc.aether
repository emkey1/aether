fn main() -> Void {
    let nums: Int[] = [10, 9, 2, 5, 3, 7, 101, 18];
    let n: Int = length(nums);
    let dp: Int[] = [];

    loop i in 0..n {
        dp = dp + [1];
    }

    loop i in 0..n {
        loop j in 0..i {
            if nums[j] < nums[i] {
                let cand: Int = dp[j] + 1;
                if cand > dp[i] {
                    dp[i] = cand;
                }
            }
        }
    }

    let maxLen: Int = 0;
    loop i in 0..n {
        if dp[i] > maxLen {
            maxLen = dp[i];
        }
    }

    fx {
        println("lis = ", maxLen);
    }
    ret;
}