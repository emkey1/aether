fn main() -> Void {
    let xs: Int[] = [3, 1, 4, 1, 5];
    let sum: Int = 0;
    let max: Int = xs[0];
    let n: Int = length(xs);

    loop i in 0..n {
        let v: Int = xs[i];
        sum = sum + v;
        if v > max {
            max = v;
        }
    }

    fx {
        println("sum=", sum);
        println("max=", max);
        println("count=", n);
    }
    ret;
}