fn collatzSteps(n: Int) -> Int {
    let count: Int = 0;
    loop n != 1 {
        if n % 2 == 0 {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    ret count;
}

fn main() -> Void {
    let n: Int = 27;
    let steps: Int = collatzSteps(n);
    fx {
        println("steps = ", steps);
    }
    ret;
}