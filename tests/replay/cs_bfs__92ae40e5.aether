fn main() -> Void {
    let adj: Int[][] = [[1, 4], [0, 2, 5], [1, 3], [2, 6], [0, 5], [1, 4, 6], [3, 5]];
    let queue: Int[] = [0];
    let visited: Bool[] = [false, false, false, false, false, false, false];
    let result: Int[] = [0];
    visited[0] = true;

    let i: Int = 0;
    loop i < length(queue) {
        let u: Int = queue[i];
        let neighbors: Int[] = adj[u];
        let j: Int = 0;
        loop j < length(neighbors) {
            let v: Int = neighbors[j];
            if !visited[v] {
                visited[v] = true;
                queue = queue + [v];
                result = result + [v];
            }
            j = j + 1;
        }
        i = i + 1;
    }

    let out: Text = itoa(result[0]);
    let k: Int = 1;
    loop k < length(result) {
        out = out + " " + itoa(result[k]);
        k = k + 1;
    }
    fx { println(out); }
    ret;
}