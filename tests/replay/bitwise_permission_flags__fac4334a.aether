const READ: Int = 1;
const WRITE: Int = 2;
const EXEC: Int = 4;

@pure
fn permissionString(flags: Int) -> Text {
    let result: Text = "";
    if (flags & READ) != 0 {
        result = result + "r";
    } else {
        result = result + "-";
    }
    if (flags & WRITE) != 0 {
        result = result + "w";
    } else {
        result = result + "-";
    }
    if (flags & EXEC) != 0 {
        result = result + "x";
    } else {
        result = result + "-";
    }
    ret result;
}

fn main() -> Void {
    let flagsList: Int[] = [0, 1, 3, 5, 7, 6];
    let union: Int = 0;
    loop i in 0..length(flagsList) {
        let f: Int = flagsList[i];
        let s: Text = permissionString(f);
        fx {
            println(f, " -> ", s);
        }
        union = union | f;
    }
    let shifted: Int = union << 2;
    fx {
        println("union=", union, " shifted=", shifted);
    }
    ret;
}