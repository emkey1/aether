fn main() -> Void {
    if !has_toon() {
        fx {
            println("yyjson unavailable");
        }
        ret;
    }

    let doc: ToonDoc;
    fx {
        doc = toon_parse_file("words_hard_h.json");
    }
    let root: ToonNode = toon_root(doc);
    let words: ToonNode = toon_key(root, "words");

    let shortCount: Int = 0;
    let mediumCount: Int = 0;
    let longCount: Int = 0;
    let totalChars: Int = 0;
    let longestWord: Text = "";
    let longestLen: Int = 0;

    loop i in 0..toon_len(words) {
        let entry: ToonNode = toon_at(words, i);
        let w: ToonNode = toon_key(entry, "w");
        let word: Text = toon_text_value(w);
        let len: Int = string_len(word);

        let kind: Text;
        if len < 4 {
            kind = "short";
            shortCount = shortCount + 1;
        } else if len > 7 {
            kind = "long";
            longCount = longCount + 1;
        } else {
            kind = "medium";
            mediumCount = mediumCount + 1;
        }

        totalChars = totalChars + len;

        if len > longestLen {
            longestLen = len;
            longestWord = word;
        }

        fx {
            println("word ", i, ": ", word, " (", len, ") ", kind);
        }

        toon_free(w);
        toon_free(entry);
    }

    fx {
        println("short = ", shortCount);
        println("medium = ", mediumCount);
        println("long = ", longCount);
        println("total chars = ", totalChars);
        println("longest = ", longestWord, " (", longestLen, ")");
    }

    toon_free(words);
    toon_close(doc);
    ret;
}