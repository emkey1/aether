fn main() -> Void {
    loop i in 1..16 {
        if i % 15 == 0 {
            fx { println("FizzBuzz"); }
        } else if i % 3 == 0 {
            fx { println("Fizz"); }
        } else if i % 5 == 0 {
            fx { println("Buzz"); }
        } else {
            fx { println(i); }
        }
    }
    ret;
}