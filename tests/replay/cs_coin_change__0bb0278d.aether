fn main() -> Void {
    let amount: Int = 11;
    let coins: Int[] = [1, 2, 5];
    let n: Int = length(coins);
    
    let dp: Int[] = [];
    loop i in 0..amount + 1 {
        dp = dp + [1000];
    }
    dp[0] = 0;
    
    loop i in 1..amount + 1 {
        loop j in 0..n {
            let c: Int = coins[j];
            if i >= c {
                let candidate: Int = dp[i - c] + 1;
                if candidate < dp[i] {
                    dp[i] = candidate;
                }
            }
        }
    }
    
    fx {
        println("coins = ", dp[amount]);
    }
    ret;
}