fn binary_search(arr: Int[], target: Int) -> Int {
    let low: Int = 0;
    let high: Int = length(arr) - 1;

    loop low <= high {
        let mid: Int = (low + high) / 2;
        if arr[mid] == target {
            ret mid;
        }
        if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    ret -1;
}

fn main() -> Void {
    let arr: Int[] = [1, 3, 5, 7, 9, 11];
    let target: Int = 7;
    let idx: Int = binary_search(arr, target);

    fx {
        println("index = ", idx);
    }

    ret;
}