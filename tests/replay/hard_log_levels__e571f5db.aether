fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc;
    fx { doc = toon_parse_file("events_hard_b.json"); }
    let root: ToonNode = toon_root(doc);
    let events: ToonNode = toon_key(root, "events");

    let infoCount: Int = 0;
    let warnCount: Int = 0;
    let errorCount: Int = 0;
    let firstError: Int = -1;

    loop i in 0..toon_len(events) {
        let event: ToonNode = toon_at(events, i);
        let levelText: Text = toon_get_text(event, "level");
        let msgText: Text = toon_get_text(event, "msg");

        fx {
            println("event ", i, ":", " ", levelText, " / ", msgText);
        }

        if levelText == "info" {
            infoCount = infoCount + 1;
        } else if levelText == "warn" {
            warnCount = warnCount + 1;
        } else if levelText == "error" {
            errorCount = errorCount + 1;
            if firstError == -1 {
                firstError = i;
            }
        }

        toon_free(event);
    }

    fx {
        println("info = ", infoCount);
        println("warn = ", warnCount);
        println("error = ", errorCount);
    }

    let dominant: Text = "info";
    if warnCount > infoCount {
        dominant = "warn";
    }
    if errorCount > infoCount && errorCount > warnCount {
        dominant = "error";
    }

    fx {
        println("dominant = ", dominant);
    }

    if firstError == -1 {
        fx {
            println("first error: none");
        }
    } else {
        fx {
            println("first error at index ", firstError);
        }
    }

    toon_close(doc);
    ret;
}