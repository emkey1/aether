fn neighbors(n: Int) -> Int[] {
    if n == 0 { ret [1, 4]; }
    if n == 1 { ret [0, 2, 5]; }
    if n == 2 { ret [1, 3]; }
    if n == 3 { ret [2, 6]; }
    if n == 4 { ret [0, 5]; }
    if n == 5 { ret [1, 4, 6]; }
    ret [3, 5];
}

fn main() -> Void {
    let queue: Int[] = [0];
    let visited: Bool[] = [false, false, false, false, false, false, false];
    let order: Int[] = [];
    visited[0] = true;
    let head: Int = 0;

    loop head < length(queue) {
        let u: Int = queue[head];
        head = head + 1;
        order = order + [u];

        let nbrs: Int[] = neighbors(u);
        loop i in 0..length(nbrs) {
            let v: Int = nbrs[i];
            if !visited[v] {
                visited[v] = true;
                queue = queue + [v];
            }
        }
    }

    fx {
        loop i in 0..length(order) {
            if i > 0 {
                print(" ");
            }
            print(order[i]);
        }
        println();
    }
    ret;
}