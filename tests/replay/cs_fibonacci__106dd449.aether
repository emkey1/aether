fn main() -> Void {
    let a: Int = 0;
    let b: Int = 1;
    let i: Int = 0;
    let result: Text = "";
    
    loop i < 10 {
        if i > 0 {
            result = result + ", ";
        }
        result = result + itoa(a);
        let next: Int = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    
    fx { println(result); }
    ret;
}