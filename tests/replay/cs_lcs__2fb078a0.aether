fn main() -> Void {
    let s1: Text = "ABCBDAB";
    let s2: Text = "BDCAB";
    let m: Int = string_len(s1);
    let n: Int = string_len(s2);
    let cols: Int = n + 1;

    let dp: Int[] = [];
    loop k in 0..(m + 1) * cols {
        dp = dp + [0];
    }

    loop i in 1..m + 1 {
        loop j in 1..n + 1 {
            if copy(s1, i, 1) == copy(s2, j, 1) {
                dp[i * cols + j] = dp[(i - 1) * cols + (j - 1)] + 1;
            } else {
                let a: Int = dp[(i - 1) * cols + j];
                let b: Int = dp[i * cols + (j - 1)];
                if a > b {
                    dp[i * cols + j] = a;
                } else {
                    dp[i * cols + j] = b;
                }
            }
        }
    }

    fx {
        println("lcs = ", dp[m * cols + n]);
    }
    ret;
}