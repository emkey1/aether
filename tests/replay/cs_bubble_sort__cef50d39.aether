fn main() -> Void {
    let xs: Int[] = [5, 2, 8, 1, 9, 3];
    let n: Int = length(xs);

    // Bubble sort
    loop i in 0..n {
        loop j in 0..(n - i - 1) {
            if xs[j] > xs[j + 1] {
                let temp: Int = xs[j];
                xs[j] = xs[j + 1];
                xs[j + 1] = temp;
            }
        }
    }

    // Print sorted list with ", " separator
    fx {
        print(xs[0]);
        loop i in 1..n {
            print(", ", xs[i]);
        }
        println();
    }
    ret;
}