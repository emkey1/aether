fn main() -> Void {
    let xs: Int[] = [3, 1, 4, 1, 5];
    let sum: Int = 0;
    let max: Int = xs[0];

    loop i in 0..length(xs) {
        let v: Int = xs[i];
        sum = sum + v;
        if v > max {
            max = v;
        }
    }

    fx {
        println("sum=", sum);
        println("max=", max);
        println("count=", length(xs));
    }

    ret;
}