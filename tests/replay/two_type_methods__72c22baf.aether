type Point {
    x: Int;
    y: Int;
}

type Box {
    width: Int;
    height: Int;
}

fn shiftX(self: Point, dx: Int) -> Int {
    ret self.x + dx;
}

fn area(self: Box) -> Int {
    ret self.width * self.height;
}

fn main() -> Void {
    let p: Point = Point { x: 3, y: 4 };
    let b: Box = Box { width: 5, height: 6 };
    let shifted: Int = p.shiftX(10);
    let a: Int = b.area();
    let combined: Int = shifted + a;
    fx {
        println("shiftedX=", shifted);
        println("area=", a);
        println("combined=", combined);
    }
    ret;
}