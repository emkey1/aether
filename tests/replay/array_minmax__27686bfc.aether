fn main() -> Void {
    let xs: Int[] = [12, 5, 23, 8, 19];
    let n: Int = length(xs);

    let min: Int = xs[0];
    let max: Int = xs[0];

    loop i in 1..n {
        let val: Int = xs[i];
        if val < min {
            min = val;
        }
        if val > max {
            max = val;
        }
    }

    let range: Int = max - min;

    fx {
        println("min = ", min);
        println("max = ", max);
        println("range = ", range);
    }

    ret;
}