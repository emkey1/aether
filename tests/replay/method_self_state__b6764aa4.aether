type Counter {
    hits: Int = 0;
    label: Text = "";

    fn add(amount: Int) -> Void {
        self.hits = self.hits + amount;
        ret;
    }

    fn describe(prefix: Text) -> Text {
        ret prefix + self.label + "=" + int_to_text(self.hits);
    }
}

fn main() -> Void {
    let c: Counter = new Counter { label: "clicks" };
    let amounts: Int[] = [3, 1, 4, 1, 5];
    loop i in 0..length(amounts) {
        c.add(amounts[i]);
    }
    fx {
        println(c.describe("counter "));
        println("final=", c.hits);
    }
    ret;
}