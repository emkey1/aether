fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc;
    fx { doc = toon_parse_file("rosters.json"); }
    let root: ToonNode = toon_root(doc);
    let teams: ToonNode = toon_key(root, "teams");

    let total: Int = 0;

    loop i in 0..toon_len(teams) {
        let team: ToonNode = toon_at(teams, i);
        let name: ToonNode = toon_key(team, "name");
        let members: ToonNode = toon_key(team, "members");
        let count: Int = toon_len(members);

        fx {
            println("team ", i, ": ", toon_text_value(name), " / ", count);
        }

        total = total + count;

        toon_free(name);
        toon_free(members);
        toon_free(team);
    }

    fx {
        println("total members = ", total);
    }

    toon_close(doc);
    ret;
}