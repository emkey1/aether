fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc;
    fx { doc = toon_parse_file("rows.json"); }
    let root: ToonNode = toon_root(doc);
    let rows: ToonNode = toon_key(root, "rows");
    let missing: Int = 0;

    loop i in 0..toon_len(rows) {
        let row: ToonNode = toon_at(rows, i);
        let code: Text = "EMPTY";
        if toon_has_key(row, "meta") {
            let meta: ToonNode = toon_key(row, "meta");
            if toon_has_key(meta, "code") {
                code = toon_get_text(meta, "code");
            }
            toon_free(meta);
        }
        fx {
            println("row ", i, " = ", code);
        }
        if code == "EMPTY" {
            missing = missing + 1;
        }
        toon_free(row);
    }

    fx {
        println("missing = ", missing);
    }

    toon_close(doc);
    ret;
}