fn main() -> Void {
    if !has_toon() {
        fx {
            println("toon unavailable");
        }
        ret;
    }

    let doc: ToonDoc = toon_parse("{\"name\":\"Aether\",\"score\":42}");
    let root: ToonNode = toon_root(doc);
    let name: Text = toon_get_text(root, "name");
    let score: Int = toon_get_int(root, "score");

    fx {
        println(name, " ", score);
    }

    toon_close(doc);
    ret;
}