fn merge(a: Int[], b: Int[]) -> Int[] {
    let result: Int[] = [];
    let i: Int = 0;
    let j: Int = 0;
    loop {
        if i >= length(a) || j >= length(b) {
            break;
        }
        if a[i] <= b[j] {
            result = result + [a[i]];
            i = i + 1;
        } else {
            result = result + [b[j]];
            j = j + 1;
        }
    }
    loop i < length(a) {
        result = result + [a[i]];
        i = i + 1;
    }
    loop j < length(b) {
        result = result + [b[j]];
        j = j + 1;
    }
    ret result;
}

fn mergeSort(arr: Int[]) -> Int[] {
    let n: Int = length(arr);
    if n <= 1 {
        ret arr;
    }
    let mid: Int = n / 2;
    let left: Int[] = [];
    let right: Int[] = [];
    loop i in 0..mid {
        left = left + [arr[i]];
    }
    loop i in mid..n {
        right = right + [arr[i]];
    }
    let sortedLeft: Int[] = mergeSort(left);
    let sortedRight: Int[] = mergeSort(right);
    ret merge(sortedLeft, sortedRight);
}

fn main() -> Void {
    let xs: Int[] = [38, 27, 43, 3, 9, 82, 10];
    let sorted: Int[] = mergeSort(xs);
    fx {
        let first: Bool = true;
        loop i in 0..length(sorted) {
            if !first {
                print(", ");
            }
            print(sorted[i]);
            first = false;
        }
        print("\n");
    }
    ret;
}