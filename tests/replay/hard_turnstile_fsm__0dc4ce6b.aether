fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc;
    fx { doc = toon_parse_file("events_hard_g.json"); }
    let root: ToonNode = toon_root(doc);
    let events: ToonNode = toon_key(root, "events");

    let state: Text = "locked";
    let passes: Int = 0;
    let denied: Int = 0;

    loop i in 0..toon_len(events) {
        let event: ToonNode = toon_at(events, i);
        let e: Text = toon_get_text(event, "e");

        if state == "locked" {
            if e == "coin" {
                state = "unlocked";
                fx { println("event ", i, ": coin -> unlocked"); }
            } else {
                denied = denied + 1;
                fx { println("event ", i, ": push -> DENIED"); }
            }
        } else {
            if e == "push" {
                state = "locked";
                passes = passes + 1;
                fx { println("event ", i, ": push -> PASS"); }
            } else {
                fx { println("event ", i, ": coin -> thanks"); }
            }
        }

        toon_free(event);
    }

    fx {
        println("passes = ", passes);
        println("denied = ", denied);
        println("final state = ", state);
    }

    toon_close(doc);
    ret;
}