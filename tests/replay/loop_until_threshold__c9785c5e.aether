fn main() -> Void {
    let level: Int = 0;
    let steps: Int = 0;

    loop {
        level = level + 7;
        steps = steps + 1;
        fx {
            println("step ", steps, ": ", level);
        }
        if level >= 30 {
            break;
        }
    }

    fx {
        println("steps = ", steps);
    }
    ret;
}