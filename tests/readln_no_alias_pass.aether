// Regression: a Text filled by readln's out-parameter used to be mutated IN
// PLACE, so every earlier copy shared that object and silently tracked later
// reads, and reading a file into an array yielded N copies of the last line.
// readln is gone (D55); its replacements return fresh values, which this
// keeps checking: each line read stays distinct from the next.
fn main() -> Void {
    let line: Text = "";
    let a: Text = "";
    let b: Text = "";
    let lines: Text[] = [];

    fx {
        write_file("readln_no_alias.txt", "one\ntwo\nthree\n");
        let all: Text[] = read_lines("readln_no_alias.txt");
        line = all[0];
        a = line;
        line = all[1];
        b = line;
        line = all[2];
        loop l in read_lines("readln_no_alias.txt") {
            lines = lines + [l];
        }
        let gone: Bool = delete_file("readln_no_alias.txt");

        println(a, " ", b, " ", line);
        loop i in 0..length(lines) {
            print(lines[i], " ");
        }
        println("");
    }
    ret;
}
