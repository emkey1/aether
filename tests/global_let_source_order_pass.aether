// A top-level `let`'s initializer runs where the `let` stands, not ahead of the
// statements above it. Regression: the parser routed every top-level `let` into
// the program's declaration section, so the compiler emitted all of their
// initializers as one block before the first statement -- `b` read `a` as 1,
// `other` was bound to the first Node rather than the one `head` holds by then,
// and `captured` read `total` before the loop ran.
type Node { v: Int = 0; }

let a: Int = 1;
a = 5;
let b: Int = a;

let head: Node = new Node();
head = new Node();
head.v = 7;
let other: Node = head;

let total: Int = 0;
loop i in 0..4 {
    total = total + i;
}
let captured: Int = total;
total = 99;

fx {
    println(b);
    println(other.v);
    println(captured);
}
