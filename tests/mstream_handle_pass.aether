// MStream is a first-class opaque handle type: explicit declarations,
// inference from mstreamcreate/mstreamfromstring, and Text extraction via
// mstreambuffer must all compile and run (pure in-memory ops need no fx).
fn main() -> Void {
    let s: MStream = mstream_from_text("aether streams");
    let t: Text = mstream_text(s);
    fx {
        println(t);
    }
    mstream_free(s);

    let inferred = mstream_new();
    let empty: Text = mstream_text(inferred);
    fx {
        if empty == "" {
            println("empty ok");
        }
    }
    mstream_free(inferred);
    ret;
}
