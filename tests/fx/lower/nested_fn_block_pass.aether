// D62: a nested fn may be declared in an inner block of its host; it reads
// the host's locals and is visible inside that block.
fn main() -> Void {
    let xs: Int[] = [3, 1, 2];
    if length(xs) > 0 {
        fn helper(x: Int) -> Int {
            ret x * length(xs);
        }
        fx { println(helper(xs[0])); }
    }
}
