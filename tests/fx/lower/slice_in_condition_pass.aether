// A slice (or a record literal) in a position that is evaluated on every pass
// or only sometimes: a loop condition in each spelling, a range loop's upper
// bound (re-read before every pass), an `else if` condition, the right operand
// of `&&` and `||`, and a branch of `?:` and of an if-expression. The slice is
// built in a temp ahead of the statement, and it used to be built once there:
// `loop total(xs[i..5]) > 5 { i = i + 1; }` never saw `i` change and spun
// forever, and a guarded slice was copied (and failed out of bounds) even when
// its guard was false. Each result here matches the same expression written
// with `part`, a function that builds the same copy. The `> 50` breaks only
// stop a regression from spinning.
type P { x: Int = 0; }

type Win {
    data: Int[] = [];
    fn shrink(self) -> Int {
        let n: Int = 0;
        while total(self.data[n..length(self.data)]) > 6 {
            n = n + 1;
            if n > 50 { break; }
        }
        ret n;
    }
}

fn px(p: P) -> Int { ret p.x; }

fn total(xs: Int[]) -> Int {
    let s: Int = 0;
    loop i in 0..length(xs) { s = s + xs[i]; }
    ret s;
}

fn part(xs: Int[], a: Int, b: Int) -> Int[] {
    let out: Int[] = [];
    loop i in a..b { out = out + [xs[i]]; }
    ret out;
}

// A `ret` from inside a loop whose condition slices.
fn firstThree(xs: Int[]) -> Int {
    let i: Int = 0;
    loop total(xs[i..length(xs)]) > 2 {
        if total(xs[i..i + 1]) == 3 { ret i; }
        i = i + 1;
        if i > 50 { break; }
    }
    ret -1;
}

fn main() -> Void {
    let xs: Int[] = [1, 2, 3, 4, 5];

    let i: Int = 0;
    loop total(xs[i..5]) > 5 { i = i + 1; if i > 50 { break; } }
    let j: Int = 0;
    loop total(part(xs, j, 5)) > 5 { j = j + 1; if j > 50 { break; } }
    fx { println("loop cond ", i, " ", j); }

    i = 0;
    loop while total(xs[i..5]) > 9 { i = i + 1; if i > 50 { break; } }
    fx { println("loop while ", i); }

    i = 0;
    while (total(xs[0..i]) < 6) { i = i + 1; if i > 50 { break; } }
    fx { println("while ", i); }

    // `continue` re-tests the condition (and rebuilds the slice); `break` leaves.
    i = 0;
    let skipped: Int = 0;
    loop total(xs[i..5]) > 0 {
        i = i + 1;
        if i == 2 { skipped = skipped + 1; continue; }
        if i == 4 { break; }
        if i > 50 { break; }
    }
    fx { println("continue/break ", i, " ", skipped); }

    // The upper bound is re-read every pass, with or without a slice in it.
    let k: Int = 5;
    let runs: Int = 0;
    loop r in 0..length(xs[0..k]) { k = k - 1; runs = runs + 1; }
    let k2: Int = 5;
    let runs2: Int = 0;
    loop r in 0..length(part(xs, 0, k2)) { k2 = k2 - 1; runs2 = runs2 + 1; }
    let lim: Int = 5;
    let steps: Int = 0;
    loop r in 0..total(xs[0..lim]) step 4 { lim = lim - 1; steps = steps + 1; }
    fx { println("range bound ", runs, " ", runs2, " step ", steps); }

    // An `else if` condition runs only when the conditions before it were false.
    let n: Int = 9;
    let seen: Int = 0;
    loop q in 0..3 {
        if q == 0 { seen = seen + 1; }
        else if n <= length(xs) && total(xs[0..n]) > 0 { seen = seen + 10; }
        else if q >= 1 || total(xs[0..n]) > 0 { seen = seen + 100; }
    }
    fx { println("else if ", seen); }

    // A guarded slice is not built when its guard decides the result.
    let g1: Bool = n <= length(xs) && total(xs[0..n]) > 0;
    let g2: Bool = n > length(xs) || total(xs[0..n]) > 0;
    let m: Int = 0;
    loop m < 5 && total(xs[m..5]) > 9 { m = m + 1; if m > 50 { break; } }
    fx { println("short circuit ", g1, " ", g2, " in loop ", m); }

    // Only the branch taken builds its slice.
    let t1: Int = n > 3 ? 0 : total(xs[0..n]);
    let t2: Int = if n > 3 { 1 } else { total(xs[0..n]) };
    let t3: Int[] = n > 3 ? xs[1..3] : xs[0..n];
    let t4: Int = if n > 20 { 0 } else if n > 3 { total(xs[1..3]) } else { total(xs[0..n]) };
    fx { println("conditional ", t1, " ", t2, " ", length(t3), " ", t3[0], " ", t4); }

    // A slice of a field in a method's condition, and `ret` from such a loop.
    let w: Win = new Win();
    w.data = [5, 1, 1, 1, 1];
    fx { println("method ", w.shrink(), " ret ", firstThree(xs)); }

    // A record literal in a condition is built the same way.
    let c: Int = 0;
    loop px(P { x: c }) < 3 { c = c + 1; if c > 50 { break; } }
    fx { println("record literal ", c); }
    ret;
}
