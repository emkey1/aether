// D64: a nested fn assigns its enclosing function's local and the enclosing
// variable changes (it was FUNC-002 under D62). Models write this to count
// N-Queens solutions.
fn main() -> Void {
    let n: Int = 4;
    let count: Int = 0;
    fn backtrack(row: Int) -> Void {
        if row == n {
            count = count + 1;
            ret;
        }
        backtrack(row + 1);
    }
    backtrack(0);
    fx { println(count); }
}
