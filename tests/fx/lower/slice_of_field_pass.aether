// A slice whose base is reached through a record: `o.f[a..b]`, a nested field,
// `self.f[a..b]` in a method, a field of an array element, a row of a 2-D
// field, and the result of a method called on such a receiver. Each used to
// fail with "[SCOPE-001] identifier '__aether_slice_0' not in scope": the
// slice is typed from its base, a field had no type the parser could name, and
// the temp was then declared with no type at all. Slicing a local, or the same
// field copied to a local first, always worked. Text fields take the `copy`
// lowering, as a Text local does.
type Item {
    name: Text = "";
    tags: Text[] = [];
    scores: Int[] = [];
}

type Inner {
    label: Text = "inner-label";
    vals: Int[] = [];
    grid: Int[][] = [];
    fn all(self) -> Int[] { ret self.vals; }
}

type Outer {
    title: String = "outer-title";
    inner: Inner;
    items: Item[] = [];
    data: Int[] = [];

    fn head(self, n: Int) -> Int[] {
        ret self.data[0..n];
    }
    fn pop(self) -> Int {
        let last: Int = self.data[length(self.data) - 1];
        self.data = self.data[0..length(self.data) - 1];
        ret last;
    }
    fn short(self) -> Text {
        ret self.title[0..5];
    }
    fn innerVals(self, a: Int, b: Int) -> Int[] {
        ret self.inner.vals[a..b];
    }
    fn firstItems(self, n: Int) -> Item[] {
        ret self.items[0..n];
    }
    fn tagPair(self, i: Int) -> Text[] {
        ret self.items[i].tags[0..2];
    }
}

// An extension method: `self` is an ordinary typed parameter here.
fn lastTwo(self: Outer) -> Int[] {
    ret self.data[length(self.data) - 2..length(self.data)];
}

fn show(label: Text, xs: Int[]) -> Void {
    fx {
        print(label, " len=", length(xs), " [");
        loop i in 0..length(xs) {
            print(" ", xs[i]);
        }
        println(" ]");
    }
    ret;
}

fn sum(xs: Int[]) -> Int {
    let t: Int = 0;
    loop i in 0..length(xs) {
        t = t + xs[i];
    }
    ret t;
}

fn main() -> Void {
    let o: Outer = new Outer();
    o.inner = new Inner();
    o.data = [10, 20, 30, 40, 50];
    o.inner.vals = [1, 2, 3, 4];
    o.inner.grid = [[1, 2, 3], [4, 5, 6]];
    let a: Item = new Item { name: "alpha-item", tags: ["x", "y", "z"], scores: [5, 6, 7] };
    let b: Item = new Item { name: "beta-item", tags: ["p", "q", "r"], scores: [1, 2, 3] };
    o.items = [a, b];
    let items: Item[] = [a, b];

    // A field, an array and a Text.
    let f1: Int[] = o.data[1..4];
    show("field", f1);
    fx { println("field text ", o.title[6..11]); }

    // A nested field.
    let f2: Int[] = o.inner.vals[1..3];
    show("nested", f2);
    fx { println("nested text ", o.inner.label[0..5]); }

    // A field of an element of an array of records.
    let i: Int = 1;
    let t1: Text[] = items[i].tags[0..2];
    fx {
        println("element ", t1[0], t1[1], " ", length(t1));
        println("element text ", items[0].name[0..5]);
    }
    let s1: Int[] = o.items[0].scores[1..3];
    show("field element", s1);

    // A row of a 2-D field, and a slice of its rows.
    let g1: Int[] = o.inner.grid[1][0..2];
    show("grid row", g1);
    let g2: Int[][] = o.inner.grid[0..1];
    fx { println("grid rows ", length(g2), " ", g2[0][2]); }

    // A field that holds records.
    let its: Item[] = o.items[1..2];
    fx { println("records ", length(its), " ", its[0].name); }

    // `self.field` inside methods, in `ret` and as an assignment's source.
    let h1: Int[] = o.head(2);
    show("self", h1);
    let h2: Int[] = o.innerVals(1, 4);
    show("self nested", h2);
    let fi: Item[] = o.firstItems(1);
    let tp: Text[] = o.tagPair(1);
    fx { println("self text ", o.short(), " ", length(fi), " ", fi[0].name, " ", tp[0], tp[1]); }
    let popped: Int = o.pop();
    fx { println("popped ", popped); }
    show("after pop", o.data);
    let e1: Int[] = o.lastTwo();
    show("extension", e1);

    // Wherever a local slice may stand: a direct argument, a further index, a
    // concat operand, an inferred let.
    fx {
        println("argument ", sum(o.data[0..2]));
        println("indexed ", o.data[1..3][0]);
    }
    let cc: Int[] = o.data[0..1] + o.inner.vals[2..4];
    show("concat", cc);
    let inf = o.data[0..2];
    show("inferred", inf);

    // A slice is a copy: writing to it leaves the field alone.
    f1[0] = 999;
    show("field after write", o.data);

    // The result of a method called on a field and on an element.
    let m1: Int[] = o.inner.all()[1..3];
    show("method on field", m1);
    let inners: Inner[] = [o.inner];
    let m2: Int[] = inners[0].all()[0..2];
    show("method on element", m2);

    // A slice of a field assigned back to a field.
    o.data = o.data[1..3];
    show("assigned", o.data);
    o.items[0].scores = o.items[0].scores[0..1];
    show("element assigned", o.items[0].scores);

    // A type declared after its use: field types come from the forward scan.
    let late: Late = new Late();
    late.xs = [7, 8, 9];
    let l1: Int[] = late.xs[1..3];
    show("late type", l1);
    ret;
}

type Late {
    xs: Int[] = [];
}
