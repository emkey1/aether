// W4-47 copies a literal's array parts, and since 2026-10-16-4 it copies
// them with their rows, as `x = xs` does: a loop-built grid placed in a field,
// an array literal or a record-literal argument is a full copy, so no nested
// write through it reaches the source grid. (Until then the rows stayed
// shared and this printed "99 2 97 98".)
type Grid { cells: Int[][]; }
fn mark(g: Grid) -> Void { g.cells[1][0] = 97; ret; }
fn main() -> Void {
    let g: Int[][] = [];
    loop i in 0..2 {
        let row: Int[] = [];
        loop j in 0..2 { row = row + [i * 2 + j + 1]; }
        g = g + [row];
    }
    let gb: Grid = new Grid { cells: g };
    gb.cells[0][0] = 99;
    let wrap: Int[][][] = [g];
    wrap[0][1][1] = 98;
    mark(new Grid { cells: g });
    fx { println(g[0][0], " ", g[0][1], " ", g[1][0], " ", g[1][1]); }
    ret;
}
