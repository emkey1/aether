// D68 + D8 V-strict: maps are values like arrays, so a function that changes
// its map parameter and never returns it changes only its own copy: ARR-001,
// an error. Returning the map (`keep`) is the fix.
fn lose(m: Map[Text, Int]) -> Void {
    m["lost"] = 1;
}

fn keep(m: Map[Text, Int]) -> Map[Text, Int] {
    m["kept"] = 1;
    ret m;
}

fn main() -> Void {
    let a: Map[Text, Int] = {};
    lose(a);
    a = keep(a);
    fx { println(a); }
}
