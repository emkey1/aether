// D68 + D24: structural ==. Same key set and equal values; order is ignored.
// Record values compare field by field, as D24's record == does.
type P { x: Int; y: Int; }

fn main() -> Void {
    let a: Map[Text, Int] = {"x": 1, "y": 2};
    let b: Map[Text, Int] = {"y": 2, "x": 1};
    let c: Map[Text, Int] = {"x": 1};
    let e1: Map[Text, Int] = {};
    let e2: Map[Text, Int] = {};
    fx {
        println(a == b, " ", a != b, " ", a == c, " ", e1 == e2);
    }
    c["y"] = 2;
    fx { println(a == c); }
    c["y"] = 3;
    fx { println(a == c); }

    let n1: Map[Text, Map[Text, Int[]]] = {"k": {"v": [1, 2]}};
    let n2: Map[Text, Map[Text, Int[]]] = {"k": {"v": [1, 2]}};
    fx { println(n1 == n2); }
    n2["k"]["v"][1] = 3;
    fx { println(n1 == n2); }

    let r1: Map[Text, Real] = {"h": 0.5};
    let r2: Map[Text, Real] = {"h": 0.5};
    fx { println(r1 == r2); }

    let p1: Map[Text, P] = {"k": new P { x: 1, y: 2 }};
    let p2: Map[Text, P] = {"k": new P { x: 1, y: 2 }};
    fx { println(p1 == p2); }
    p2["k"].y = 3;
    fx { println(p1 == p2); }
}
