// val(text, n, code) has Pascal Val semantics on every platform: code is 0 on
// success, otherwise the 1-based position of the first bad character (one past
// the end when the text stops early), and n is left unchanged. Regression: on
// Linux, val("", n, code) reported success with n = 0 (glibc's strtoll does not
// flag an empty conversion), so a checked parse accepted the empty string.
fn tryInt(s: Text) -> Void {
    let n: Int = 5;
    let code: Int = 0;
    val(s, n, code);
    fx { println("int [", s, "] n=", n, " code=", code); }
}

fn tryReal(s: Text) -> Void {
    let r: Real = 5.0;
    let code: Int = 0;
    val(s, r, code);
    fx { println("real [", s, "] r=", r, " code=", code); }
}

fn main() -> Void {
    let ints: Text[] = ["", "-", "+", "  ", " 42", "\t7", "42 ", "-13", "+8", "007", "7x", "3.5",
                        "--1", "- 1", "0x1F", "1e3",
                        "9223372036854775807", "9223372036854775808",
                        "-9223372036854775808", "-9223372036854775809",
                        "123456789012345678901234567890"];
    loop i in 0..length(ints) { tryInt(ints[i]); }
    let reals: Text[] = ["", "-", ".", "1.", ".5", " 2.5", "2.5 ", "1e3", "1e", "1e+", "-1.5e-2",
                         "abc", "3.5x", "0x1p3", "inf", "1e400", "1e-400"];
    loop i in 0..length(reals) { tryReal(reals[i]); }
}
