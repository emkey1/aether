// W4-06: a file-scope `let parts: Text[] = split(...)` is in scope and main runs.
let parts: Text[] = split("a,b,c", ",");
let slice: Text[] = parts[1..3];
fn show() -> Void { fx { println("show ", len(parts), " ", parts[2]); } }
fn main() -> Void {
    show();
    fx { println("main ", parts[0], " ", len(slice), " ", slice[0]); }
}
