// A foreach over a field the type does not declare is the field error, not
// "cannot infer the type of the collection" with a hint to bind a typed local.
type Bag {
    data: Int[] = [];
}

fn main() -> Void {
    let b: Bag = new Bag();
    loop v in b.dta {
        fx { println(v); }
    }
    ret;
}
