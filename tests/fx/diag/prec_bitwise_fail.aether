// D88: `& | ^` bind looser than the comparisons, so each line below is an Int
// combined with a Bool. Until 2026-10-27-3 they compiled with a PREC-001
// warning and printed 1, 3 and 2.
fn main() -> Void {
    let flags: Int = 3;
    let mask: Int = 2;
    fx {
        println(flags & mask != 0);
        println(flags | mask == 2);
        println(flags ^ mask < 4);
    }
}
