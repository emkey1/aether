// W4-32's helper shape without a File (D55): helpers take the path as Text
// and each call is one whole-file operation.
fn logLine(path: Text, msg: Text) -> Void {
    fx { append_file(path, msg + "\n"); }
}

fn countLines(path: Text) -> Int {
    let n: Int = 0;
    fx { n = length(read_lines(path)); }
    ret n;
}

fn main() -> Void {
    let path: Text = "file_global_helper_tmp.txt";
    fx { write_file(path, ""); }
    logLine(path, "one");
    logLine(path, "two");
    fx {
        println(countLines(path));
        let gone: Bool = delete_file(path);
    }
}
