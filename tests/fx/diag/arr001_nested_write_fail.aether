// D8 V-strict: a write through two indices into an array parameter the
// function never returns is ARR-001, an error (a warning until 2026-10-20),
// whether the grid's rows were built by appending or written as a literal.
fn mark(seen: Bool[][], r: Int, c: Int) -> Void {
    seen[r][c] = true;
    ret;
}
fn main() -> Void {
    let seen: Bool[][] = [];
    loop i in 0..2 {
        let row: Bool[] = [];
        loop j in 0..2 { row = row + [false]; }
        seen = seen + [row];
    }
    mark(seen, 1, 1);
    fx { println(seen[1][1]); }
    ret;
}
