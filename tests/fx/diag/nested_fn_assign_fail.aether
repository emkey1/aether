// D62: a nested fn reads its enclosing function's locals but may not assign
// them (FUNC-002). Models write this to count N-Queens solutions; the fix is
// to return the count, or keep it in a record field.
fn main() -> Void {
    let n: Int = 4;
    let count: Int = 0;
    fn backtrack(row: Int) -> Void {
        if row == n {
            count = count + 1;
            ret;
        }
        backtrack(row + 1);
    }
    backtrack(0);
    fx { println(count); }
}
