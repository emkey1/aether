// `loop NAME in COLLECTION { }` over arrays (scalars and records), a Text, a
// nested array (rows bind by value), a call-valued collection, a slice, the
// `for` spelling, a TOON array node, and `continue`.
type Item { name: Text = ""; qty: Int = 0; }

fn evens(n: Int) -> Int[] {
    let out: Int[] = [];
    loop i in 0..n { if i % 2 == 0 { out = out + [i]; } }
    ret out;
}

fn main() -> Void {
    let xs: Int[] = [3, 1, 2];
    let total: Int = 0;
    loop x in xs { total = total + x; }

    let names: Text[] = ["b", "a"];
    let joined: Text = "";
    loop n in names { joined = joined + n; }

    let items: Item[] = [new Item { name: "bolt", qty: 3 }, new Item { name: "nut", qty: 5 }];
    let qty: Int = 0;
    loop it in items { qty = qty + it.qty; }

    let odds: Int = 0;
    loop v in xs { if v % 2 == 0 { continue; } odds = odds + 1; }

    let s: Text = "abc";
    let rev: Text = "";
    loop ch in s { rev = ch + rev; }

    let table: Int[][] = [[1, 2], [3, 4, 5]];
    let cells: Int = 0;
    loop row in table { loop c in row { cells = cells + c; } row[0] = 99; }

    let acc: Int = 0;
    loop e in evens(7) { acc = acc + e; }
    for f in evens(3) { acc = acc + f; }
    let part: Int[] = [5, 6, 7, 8];
    loop t in part[1..3] { acc = acc + t; }

    let doc: ToonDoc = toon_parse("{\"rows\":[{\"k\":1},{\"k\":2},{\"k\":3}]}");
    let rows: ToonNode = toon_key(toon_root(doc), "rows");
    let ksum: Int = 0;
    loop r in rows { ksum = ksum + toon_get_int_or(r, "k", 0); }
    toon_close(doc);

    fx {
        println("total=", total, " joined=", joined, " qty=", qty, " odds=", odds);
        println("rev=", rev, " cells=", cells, " table00=", table[0][0]);
        println("acc=", acc, " ksum=", ksum);
    }
    ret;
}
