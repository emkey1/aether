// Student grade report.
//
// Parses a TOON dataset of exam scores into an array of records, folds them
// into a statistics accumulator, and prints a per-student and summary report.
//
// The pattern this example exists for is **retaining** parsed rows: TOON is
// read once into a `Student[]`, then walked twice -- once to accumulate, once
// to print. The other TOON showcases fold each row straight into an
// accumulator and never keep it, so neither shows how to build an array of
// records from `toon_at`.
//
// It also runs the whole report a second time over an EMPTY dataset. Every
// derived statistic has to survive a zero divisor, and the sentinel-seeded
// min/max have to be suppressed rather than printed -- guarding two of three
// division sites and letting `min: 101` reach the output is the natural way to
// get this wrong.

const PASS_MARK: Int = 60;
const HONOR_MARK: Int = 90;
const MAX_SCORE: Int = 100;

// Written out rather than derived from PASS_MARK by arithmetic: bands built as
// `PASS_MARK + 10` / `PASS_MARK + 5` read as principled but are badly uneven
// (a 20-point B against a 5-point C). Explicit constants make the curve visible.
const GRADE_A: Int = 90;
const GRADE_B: Int = 80;
const GRADE_C: Int = 70;
const GRADE_D: Int = 60;

type Student {
    id: Text = "";
    name: Text = "Unknown";
    score: Int = 0;

    @pure
    fn gradeLetter() -> Text {
        if self.score >= GRADE_A {
            ret "A";
        }
        if self.score >= GRADE_B {
            ret "B";
        }
        if self.score >= GRADE_C {
            ret "C";
        }
        if self.score >= GRADE_D {
            ret "D";
        }
        ret "F";
    }

    @pure
    fn isPassing() -> Bool {
        ret self.score >= PASS_MARK;
    }

    @pure
    fn isHonor() -> Bool {
        ret self.score >= HONOR_MARK;
    }

    // Single source of truth: both the accumulator and the printed table read
    // their classification from here instead of re-deriving the same branches.
    @pure
    fn status() -> Text {
        if self.isHonor() {
            ret "Honor";
        }
        if self.isPassing() {
            ret "Pass";
        }
        ret "Fail";
    }
}

type Stats {
    total: Int = 0;
    passed: Int = 0;
    honors: Int = 0;
    failed: Int = 0;
    sum: Int = 0;
    // Seeded past the ends of the range so the first student always replaces
    // both. Nothing may print these until `total > 0`.
    //
    // Set at construction, not as field defaults: a field default must be a
    // LITERAL. `min: Int = MAX_SCORE + 1;` is a FIELD-003 error, and so is a
    // bare `min: Int = MAX_SCORE;` -- naming a const does not count either.
    min: Int = 0;
    max: Int = 0;

    fn record(s: Student) -> Void {
        self.total = self.total + 1;
        self.sum = self.sum + s.score;
        self.min = min(self.min, s.score);
        self.max = max(self.max, s.score);
        if s.isHonor() {
            self.honors = self.honors + 1;
        } else if s.isPassing() {
            self.passed = self.passed + 1;
        } else {
            self.failed = self.failed + 1;
        }
        ret;
    }

    @pure
    fn hasData() -> Bool {
        ret self.total > 0;
    }

    @pure
    fn average() -> Real {
        if self.total == 0 {
            ret 0.0;
        }
        ret self.sum * 1.0 / self.total;
    }

    @pure
    fn passRate() -> Real {
        if self.total == 0 {
            ret 0.0;
        }
        ret (self.passed + self.honors) * 100.0 / self.total;
    }

    @pure
    fn honorRate() -> Real {
        if self.total == 0 {
            ret 0.0;
        }
        ret self.honors * 100.0 / self.total;
    }
}

// Every derived figure goes through a guarded method above, so this needs no
// divisor check of its own. Reaching into `stats.honors * 100.0 / stats.total`
// here instead is what turns an empty dataset into a division-by-zero crash.
@pure
fn classifyDistribution(stats: Stats) -> Text {
    if !stats.hasData() {
        ret "No Data";
    }
    if stats.honorRate() >= 30.0 {
        ret "Excellent";
    }
    if stats.passRate() >= 80.0 {
        ret "Good";
    }
    if stats.passRate() >= 60.0 {
        ret "Satisfactory";
    }
    ret "Needs Improvement";
}

// Scores arrive as JSON strings, so each one is parsed rather than read with
// toon_get_int_or. The defaulted getters keep a malformed row from aborting the
// whole load.
fn loadStudents(doc: ToonDoc) -> Student[] {
    let root: ToonNode = toon_root(doc);
    let result: Student[] = [];

    if !toon_has_key(root, "students") {
        ret result;
    }

    let rows: ToonNode = toon_key(root, "students");
    loop i in 0..toon_len(rows) {
        let row: ToonNode = toon_at(rows, i);
        let s: Student = new Student {
            id: toon_get_text_or(row, "id", "?"),
            name: toon_get_text_or(row, "name", "Unknown"),
            score: parse_int(toon_get_text_or(row, "score", "0"))
        };
        result = result + [s];
    }
    ret result;
}

fn tally(students: Student[]) -> Stats {
    let stats: Stats = new Stats { min: MAX_SCORE + 1, max: -1 };
    loop i in 0..length(students) {
        stats.record(students[i]);
    }
    ret stats;
}

fn printSummary(stats: Stats) -> Void {
    fx {
        println("Total Students: ", stats.total);
        println("Passed:         ", stats.passed + stats.honors);
        println("Honors:         ", stats.honors);
        println("Failed:         ", stats.failed);
    }
    if !stats.hasData() {
        fx {
            println("Average Score:  n/a");
            println("Score Range:    n/a");
            println("Pass Rate:      n/a");
        }
        ret;
    }
    fx {
        println("Average Score:  ", formatfloat(stats.average(), 2));
        println("Score Range:    ", stats.min, " to ", stats.max);
        println("Pass Rate:      ", formatfloat(stats.passRate(), 1), "%");
    }
    ret;
}

fn printReport(label: Text, students: Student[], stats: Stats) -> Void {
    fx {
        println("========================================");
        println("  STUDENT GRADE REPORT -- ", label);
        println("========================================");
        println("");
    }
    printSummary(stats);
    fx {
        println("Distribution:   ", classifyDistribution(stats));
        println("");
        println("----------------------------------------");
        println("Individual Results:");
        println("----------------------------------------");
    }
    if length(students) == 0 {
        fx {
            println("(no students in this dataset)");
            println("");
        }
        ret;
    }
    loop i in 0..length(students) {
        let s: Student = students[i];
        fx {
            println(s.id, " | ", s.name, " | ", s.score,
                    " | ", s.gradeLetter(), " | ", s.status());
        }
    }
    fx {
        println("");
    }
    ret;
}

fn runReport(label: Text, payload: Text) -> Void {
    let doc: ToonDoc = toon_parse(payload);
    let students: Student[] = loadStudents(doc);
    let stats: Stats = tally(students);
    printReport(label, students, stats);
    toon_close(doc);
    ret;
}

fn main() -> Void {
    if !has_toon() {
        fx {
            println("structured data support unavailable");
        }
        ret;
    }

    let dataset: Text =
        "{ \"students\": [" +
        "  { \"id\": \"S001\", \"name\": \"Alice\",   \"score\": \"95\" }," +
        "  { \"id\": \"S002\", \"name\": \"Bob\",     \"score\": \"72\" }," +
        "  { \"id\": \"S003\", \"name\": \"Charlie\", \"score\": \"88\" }," +
        "  { \"id\": \"S004\", \"name\": \"Diana\",   \"score\": \"45\" }," +
        "  { \"id\": \"S005\", \"name\": \"Eve\",     \"score\": \"67\" }," +
        "  { \"id\": \"S006\", \"name\": \"Frank\",   \"score\": \"91\" }," +
        "  { \"id\": \"S007\", \"name\": \"Grace\",   \"score\": \"59\" }," +
        "  { \"id\": \"S008\", \"name\": \"Hank\",    \"score\": \"78\" }," +
        "  { \"id\": \"S009\", \"name\": \"Ivy\",     \"score\": \"83\" }," +
        "  { \"id\": \"S010\", \"name\": \"Jack\",    \"score\": \"55\" }," +
        "  { \"id\": \"S011\", \"name\": \"Kate\",    \"score\": \"97\" }," +
        "  { \"id\": \"S012\", \"name\": \"Leo\",     \"score\": \"62\" }" +
        "]}";

    runReport("SPRING TERM", dataset);
    // Same code path, no rows: every rate reports n/a instead of dividing by
    // zero, and the sentinel min/max never reach the page.
    runReport("SUMMER TERM", "{ \"students\": [] }");
    ret;
}
