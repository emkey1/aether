// Reading and writing file contents.
//
// Each file operation is one call on a path (Text); there is no handle to
// open or close:
//
//     write_file(path, text)    create or truncate, then write `text`
//     append_file(path, text)   add `text` at the end (creating the file)
//     read_file(path)           the whole file as Text
//     read_lines(path)          its lines as Text[], without the line breaks
//     file_exists(path)         Bool
//     delete_file(path)         Bool: true when it was deleted
//     rename_file(from, to)     Bool: true when it was renamed
//
// The text you write is written as is: end each line with "\n" yourself.
// Reading a file that does not exist is a run-time error, so check
// file_exists first when it may be missing.
//
// All of it is effectful, so all of it lives inside `fx`.

const DATA_PATH: Text = "file_io_demo.txt";

fn main() -> Void {
    let count: Int = 0;
    let longest: Text = "";

    fx {
        // Write. write_file truncates, so this always starts from empty.
        write_file(DATA_PATH, "alpha\nbeta\ngamma\n");
        println("wrote 3 lines to ", DATA_PATH);

        // Append keeps what is there.
        append_file(DATA_PATH, "delta\n");
        println("appended 1 more");
        println("");
    }

    fx {
        // Read: one Text per line, the line breaks removed.
        loop line in read_lines(DATA_PATH) {
            count = count + 1;
            if length(line) > length(longest) {
                longest = line;
            }
            println("  line ", count, ": ", line);
        }
    }

    fx {
        println("");
        println("lines read : ", count);
        println("longest    : ", longest);
        println("exists     : ", file_exists(DATA_PATH));

        // Leave the directory as we found it.
        let removed: Bool = delete_file(DATA_PATH);
        println("after erase: ", file_exists(DATA_PATH));
    }
    ret;
}
