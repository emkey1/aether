// Real -> Text: the three conversions, and the one arity that does not exist.
//
// `formatfloat` takes one or two arguments -- format_float(value[, precision]).
// It has no width parameter: `format_float(v, 0, 2)` is a compile-time
// [BUILT-002] arity error. The width:precision spelling belongs to the separate
// `value:width:precision` form, which is println-only and cannot be bound to a
// Text.

fn main() -> Void {
    let ratio: Real = 87.4567;

    let two: Text = format_float(ratio, 2);      // "87.46" -- precision only
    let none: Text = format_float(ratio, 0);     // "87"
    let full: Text = real_to_text(ratio);          // "87.456700" -- always 6 dp

    // Only the formatfloat/realtostr results are Text, so only they concatenate.
    let label: Text = "score: " + format_float(ratio, 1) + "%";

    fx {
        println("format_float(r, 2) = ", two);
        println("format_float(r, 0) = ", none);
        println("real_to_text(r)      = ", full);
        println("concatenated      = ", label);
        println("println-only form = ", ratio:0:2);
        println("width 8, prec 2   = [", ratio:8:2, "]");
    }
    ret;
}
