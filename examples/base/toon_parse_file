fn main() -> Void {
    if !has_toon() {
        fx {
            println("yyjson unavailable");
        }
        ret;
    }

    // The payload sits beside this file: cwd-relative when run from
    // examples/base, with a fallback for a run from the repository root.
    let path: Text = "toon_parse_file_payload.json";
    let local: Bool = false;
    fx { local = fileexists(path); }
    if !local {
        path = "examples/base/toon_parse_file_payload.json";
    }
    let doc: ToonDoc;
    fx { doc = toon_parse_file(path); }   // reads a file -> effectful (FX-001)
    let root: ToonNode = toon_root(doc);
    let name: Text = toon_get_text(root, "name");
    let count: Int = toon_get_int(root, "count");

    fx {
        println("name = ", name);
        println("count = ", count);
    }

    toon_close(doc);
    ret;
}
