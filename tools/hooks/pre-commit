#!/bin/bash
# Opt-in reminder for guide stamps. It never edits a file, never stages
# anything and never blocks a commit: it only warns when a staged guide's text
# differs from HEAD while its stamp line does not.
#
# Stamps come from tools/bump_guide_version.py, which is idempotent (it computes
# the next stamp from HEAD's), and are verified by the CTest aether_guide_stamps
# (tools/check_guide_stamps.py), so the gate does not depend on this hook being
# active. The hook that used to bump full and small here, and `git add` them, is
# retired: it mutated the index behind the author's back and double-bumped when
# the tool had already run.
#
# Activate once per clone, if you want the reminder:
#     git config core.hooksPath tools/hooks
#
git rev-parse --show-toplevel >/dev/null 2>&1 || exit 0
for g in $(git diff --cached --name-only --diff-filter=d 2>/dev/null \
             | grep -E '^docs/aether_for_llms_[a-z_]+\.md$'); do
    staged_stamp=$(git show ":$g" 2>/dev/null | grep -m1 -E '^\*Guide version:')
    head_stamp=$(git show "HEAD:$g" 2>/dev/null | grep -m1 -E '^\*Guide version:')
    if [ -n "$head_stamp" ] && [ "$staged_stamp" = "$head_stamp" ]; then
        echo "warning: $g is staged with HEAD's stamp ($head_stamp)." >&2
        echo "         Run tools/bump_guide_version.py $g, then stage it with" >&2
        echo "         docs/guide_stamps.json and its changelog row; ctest's" >&2
        echo "         aether_guide_stamps fails until they agree." >&2
    fi
done
exit 0
