fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc = toon_parse_file("numbers_hard_d.json");
    let root: ToonNode = toon_root(doc);
    let numbers: ToonNode = toon_key(root, "numbers");
    let maxSteps: Int = 0;
    let maxNumber: Int = 0;

    fn collatzSteps(n: Int) -> Int {
        if n <= 1 {
            ret 0;
        }
        if n % 2 == 0 {
            ret collatzSteps(n / 2) + 1;
        }
        ret collatzSteps(3 * n + 1) + 1;
    }

    loop i in 0..toon_len(numbers) {
        let numberNode: ToonNode = toon_at(numbers, i);
        let n: Int = toon_get_int(numberNode, "n");
        let steps: Int = collatzSteps(n);
        if steps > maxSteps {
            maxSteps = steps;
            maxNumber = n;
        }
        fx { println("number ", i, ": ", n, " -> ", steps, " steps"); }
    }

    fx { println("max steps = ", maxSteps, " (number ", maxNumber, ")"); }

    toon_close(doc);
    ret;
}