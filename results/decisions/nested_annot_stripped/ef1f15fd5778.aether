fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc = toon_parse_file("numbers_hard_d.json");
    let root: ToonNode = toon_root(doc);
    let numbers: ToonNode = toon_key(root, "numbers");

    type Result {
        n: Int = 0;
        steps: Int = 0;
    }

    fn collatz(v: Int) -> Int {
        if v <= 1 {
            ret 0;
        }
        if v % 2 == 0 {
            ret 1 + collatz(v / 2);
        } else {
            ret 1 + collatz(3 * v + 1);
        }
    }

    let results: Result[] = [];
    loop i in 0..toon_len(numbers) {
        let numNode: ToonNode = toon_at(numbers, i);
        let n: Int = toon_get_int(numNode, "n");
        let steps: Int = collatz(n);
        let res: Result = new Result { n: n, steps: steps };
        results = results + [res];
    }

    loop i in 0..length(results) {
        fx {
            println("number ", i, ": ", results[i].n, " -> ", results[i].steps, " steps");
        }
    }

    let maxSteps: Int = 0;
    let maxN: Int = 0;
    loop i in 0..length(results) {
        if results[i].steps > maxSteps || (results[i].steps == maxSteps && results[i].n < maxN) {
            maxSteps = results[i].steps;
            maxN = results[i].n;
        }
    }

    fx {
        println("max steps = ", maxSteps, " (number ", maxN, ")");
    }

    toon_close(doc);
    ret;
}