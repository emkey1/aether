use "yyjson";

fn main() -> Void {
    if !has_toon() {
        fx { println("yyjson unavailable"); }
        ret;
    }

    let doc: ToonDoc = toon_parse_file("words_hard_h.json");
    let root: ToonNode = toon_root(doc);
    let words: ToonNode = toon_key(root, "words");

    let short: Int = 0;
    let medium: Int = 0;
    let long: Int = 0;
    let total: Int = 0;
    let mut longest: Text = "";

    loop i in 0..toon_len(words) {
        let word: ToonNode = toon_at(words, i);
        let w: Text = toon_get_text_or(word, "w", "?");
        let len: Int = string_len(w);

        total = total + len;

        if len < 4 { short = short + 1; }
        else if len > 7 { long = long + 1; }
        else { medium = medium + 1; }

        if len > string_len(longest) {
            longest = w;
        }

        fx { println("word ", i, ": ", w, " (", len, ") ", classify(len)); }
    }

    fx {
        println("short = ", short);
        println("medium = ", medium);
        println("long = ", long);
        println("total chars = ", total);
        println("longest = ", longest, " (", string_len(longest), ")");
    }

    toon_close(doc);
    ret;

    fn classify(len: Int) -> Text {
        if len < 4 { ret "short"; }
        else if len > 7 { ret "long"; }
        ret "medium";
    }
}