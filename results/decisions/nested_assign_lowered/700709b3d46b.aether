let count: Int = 0;
let board: Bool[][] = [];
fn main() -> Void {
    count = 0;
    board = [];
    loop r in 0..6 {
        let row: Bool[] = [];
        loop c in 0..6 {
            row = row + [false];
        }
        board = board + [row];
    }

    fn is_safe(r: Int, c: Int) -> Bool {
        loop i in 0..r {
            if board[i][c] || (i - r) == (c - c) || (r - i) == (c - c) {
                ret false;
            }
        }
        ret true;
    }

    fn backtrack(r: Int) -> Void {
        if r == 6 {
            count = count + 1;
            ret;
        }
        loop c in 0..6 {
            if is_safe(r, c) {
                board[r][c] = true;
                backtrack(r + 1);
                board[r][c] = false;
            }
        }
    }

    backtrack(0);
    fx {
        println("solutions = ", count);
    }
    ret;
}