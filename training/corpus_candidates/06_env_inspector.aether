fn main() -> Void {
    fx {
        println("=== Environment Inspector ===");

        let cwd: Text = get_current_dir();
        println("Current Dir: ", cwd);

        let home: Text = get_env("HOME");
        if home == "" {
            println("HOME not set");
        } else {
            println("HOME: ", home);
        }

        let user: Text = get_env("USER");
        if user == "" {
            user = get_env("USERNAME");
        }
        if user != "" {
            println("User: ", user);
        }

        let arg_count: Int = length(args());
        println("Argument count: ", arg_count);

        loop i in 0..arg_count {
            let arg: Text = args()[i - 1];
            println("  Arg[", i, "]: ", arg);
        }

        println("=== End ===");
    }
    ret;
}
