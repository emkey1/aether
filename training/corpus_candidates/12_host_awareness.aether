// Host awareness — CLI args, environment, filesystem probes

fn main() -> Void {
    let argc: Int = 0;
    fx {
        argc = length(args());
        println("program: ", "");
        println("args:    ", argc);
    }

    loop i in 1..argc + 1 {
        fx {
            println("arg[", i, "] = ", args()[i - 1]);
        }
    }

    let home: Text = "";
    let workers: Int = 0;
    let cwd: Text = "";
    fx {
        home = get_env("HOME");
        workers = get_env_int("WORKERS", 4);
        cwd = get_current_dir();
    }

    fx {
        println("HOME = ", home, " | WORKERS = ", workers);
        println("cwd  = ", cwd);
        if file_exists("/etc/hosts") {
            println("/etc/hosts is present");
        } else {
            println("/etc/hosts not found");
        }
        let rc: Int = mkdir("aether_out");
        if rc == 0 {
            println("created aether_out/");
        } else {
            println("mkdir returned ", rc, " (already exists is fine)");
        }
    }
    ret;
}
