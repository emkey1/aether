fn main() -> Void {
    fx {
        let session: Int = http_session();
        let out: MStream = mstream_new();
        let status: Int = http_request(session, "GET", "http://localhost:8000/", "", out);

        if status == 200 {
            let body: Text = mstream_text(out);
            println("Response (", status, "): ", body);
        } else {
            println("HTTP error: ", status);
        }

        mstream_free(out);
        http_close(session);
    }
    ret;
}
