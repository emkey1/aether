fn main() -> Void {
    let filename: Text = "my_log.txt";

    fx {
        // Write to the file: write_file creates or truncates it
        write_file(filename, "Log entry 1: System started.\n");
        append_file(filename, "Log entry 2: Processing data...\n");
        append_file(filename, "Log entry 3: System shutting down.\n");

        println("Successfully wrote to ", filename);

        // Read from the file, one Text per line
        println("Reading from ", filename, ":");
        loop line in read_lines(filename) {
            println("  ", line);
        }
    }
    ret;
}
