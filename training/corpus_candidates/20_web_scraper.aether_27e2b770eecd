fn fetch_url(url: Text) -> Text {
    let body: Text = "";
    fx {
        let session: Int = httpsession();
        let out: MStream = mstream_new();
        let status: Int = httprequest(session, "GET", url, "", out);
        if status == 200 {
            body = mstream_text(out);
        }
        mstream_free(out);
        httpclose(session);
    }
    ret body;
}

fn extract_links(html: Text) -> Text[] {
    let links: Text[] = [];
    let remaining: Text = html;
    loop true {
        let marker_pos: Int = index_of(remaining, "<a href=\"");
        if marker_pos < 0 {
            break;
        }
        let after_marker: Text = remaining[marker_pos + 9..marker_pos + 9 + string_len(remaining) - (marker_pos + 9)];
        let end_pos: Int = index_of(after_marker, "\"");
        if end_pos < 0 {
            break;
        }
        let link: Text = after_marker[..end_pos];
        links = links + [link];
        remaining = after_marker[end_pos + 1..end_pos + 1 + string_len(after_marker) - (end_pos + 1)];
    }
    ret links;
}

fn main() -> Void {
    let url: Text = "http://example.com";
    let html: Text = fetch_url(url);
    let links: Text[] = extract_links(html);
    fx {
        print("Links found: ");
        loop i in 0..length(links) {
            print(links[i], " ");
        }
        println("");
    }
    ret;
}
